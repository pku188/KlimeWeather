msgid "Reset"
msgstr "Скинути"

#: contents/ui/configGeneral.qml:224
msgid "Cancel"
msgstr "Скасувати"

#: contents/ui/configLocation.qml:131
msgid "Searching…"
msgstr "Триває пошук..."

#: contents/ui/configLocation.qml:146
msgid "No match for “%1”. Try just the place name."
