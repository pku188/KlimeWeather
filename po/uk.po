msgstr "Збережені місцезнаходження"

#: contents/ui/configLocation.qml:592
msgid "No saved locations yet."
msgstr "Збережених місцезнаходжень поки що немає."

#: contents/ui/configLocation.qml:658
msgid "Active"
msgstr "Поточне"

#: contents/ui/configLocation.qml:667
msgid "Remove favorite"
msgstr "Видалити з обраних"

#: contents/ui/configLocation.qml:667
msgid "Set as favorite"
msgstr "Додати до обраних"

#: contents/ui/configLocation.qml:673
