#: contents/ui/configSources.qml:79
msgid ""
"Severe-weather alerts via the <a href=\"https://invent.kde.org/webapps/foss-"
"public-alert-server\">KDE FOSS Public Alert Server</a>."
msgstr ""
"Ostrzeżenia o groźnej pogodzie przez <a href=\"https://invent.kde.org/"
"webapps/foss-public-alert-server\">KDE FOSS Public Alert Server</a>."

#: contents/ui/configSources.qml:80
msgid ""
"Place search via <a href=\"https://open-meteo.com\">Open-Meteo geocoding</"
"a>; location auto-detect via <a href=\"https://mullvad.net\">Mullvad</a>."
msgstr ""
"Wyszukiwanie miejsc przez <a href=\"https://open-meteo.com\">geokodowanie "
"Open-Meteo</a>; automatyczne wykrywanie lokalizacji przez <a href=\"https://"
"mullvad.net\">Mullvad</a>."

#: contents/ui/configSources.qml:81
msgid ""
"Icons derived from <a href=\"https://github.com/basmilius/"
"meteocons\">Meteocons</a> by Bas Milius (MIT)."
