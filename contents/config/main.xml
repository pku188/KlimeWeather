<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0
                          http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
  <kcfgfile name=""/>
  <group name="General">
    <!-- No default location: a fresh install starts unconfigured (see
         locationConfigured below) and shows a "set your location" prompt instead
         of a stand-in city. Coordinates stay 0 and are never fetched until the
         user sets a location, which flips locationConfigured true. -->
    <!-- The forecast the widget shows (General → Default forecast), and the one the
         header's source button switches to and back (Alternative forecast). GLOBAL,
         not per-location: saved locations are plain coordinates, so every one of
         them works with every forecast and switching never asks for a location
         twice. Each is an Open-Meteo models= name from the list in
         providers/OpenMeteo.qml, or "metno", MET Norway's own forecast (see
         providers/sources.js); the alternative also "none". best_match is
         Open-Meteo's own pick for the location; whatever another Open-Meteo model
         leaves out is filled in from it. An unknown default counts as best_match,
         and an unknown alternative, or the default again, as none (the button then
         doesn't switch). Carried over once from weatherProvider and openMeteoModel
         below (main.qml). -->
    <entry name="forecastSource" type="String">
      <default>best_match</default>
    </entry>
    <entry name="alternativeSource" type="String">
      <default>metno</default>
    </entry>
    <!-- Whether the alternative forecast is the one in use (the source button). -->
    <entry name="alternativeActive" type="Bool">
      <default>false</default>
    </entry>
    <!-- Deprecated: which weather API supplied the forecast, "openmeteo" or "metno",
         switched by the header's source button; alternativeActive replaced it, with
         MET Norway as the alternative. Read once at startup to carry "metno" over,
         then cleared; to be removed, with that carry-over, a release or two on. -->
    <entry name="weatherProvider" type="String">
      <default>openmeteo</default>
    </entry>
    <!-- Deprecated: the Open-Meteo model forecastSource replaced. Read once at
         startup to carry it over, then cleared; to be removed, with that carry-over,
         a release or two on. -->
    <entry name="openMeteoModel" type="String">
      <default>best_match</default>
    </entry>
    <entry name="latitude" type="Double">
      <default>0</default>
    </entry>
    <entry name="longitude" type="Double">
      <default>0</default>
    </entry>
    <entry name="locationName" type="String">
      <default></default>
    </entry>
    <!-- JSON array of { name, lat, lon } entries -->
    <entry name="savedLocations" type="String">
      <default>[]</default>
    </entry>
    <!-- latches true the first time the user sets their own location (any
         method); false out of the box drives the first-run "set your location"
         hint in the popup, which hides once a real location is chosen -->
    <!-- IANA zone of the active location ("Europe/Oslo"), captured from the
         geocoder. Resolved to a live UTC offset through Plasma's time dataengine
         so a provider that reports no timezone (met.no) can still be rendered in
         the location's own clock. Empty = fall back to the viewer's zone, which
         is what a hand-entered coordinate or a pre-existing saved location gets. -->
    <entry name="locationTimezone" type="String">
      <default></default>
    </entry>
    <entry name="locationConfigured" type="Bool">
      <default>false</default>
    </entry>
    <!-- temperature unit: celsius, fahrenheit, or system (the system locale's
         measurement system, LC_MEASUREMENT: °F where it is US imperial) -->
    <entry name="temperatureUnit" type="String">
      <default>system</default>
    </entry>
    <!-- wind speed unit: auto (follows the system locale's measurement system), kmh,
         mph, ms, kn or bft (the Beaufort scale) -->
    <entry name="windUnit" type="String">
      <default>auto</default>
    </entry>
    <!-- air pressure unit: auto (follows the system locale's measurement system), hPa,
         inHg or mmHg -->
    <entry name="pressureUnit" type="String">
      <default>auto</default>
    </entry>
    <!-- precipitation unit: auto (follows the system locale's measurement system), mm
         or in. Snowfall follows it: centimetres with mm, inches with in. -->
    <entry name="precipUnit" type="String">
      <default>auto</default>
    </entry>
    <!-- Clock format: 0 follows the system default (the locale's own time format),
         1 = 12-hour, 2 = 24-hour. -1 = never chosen, as the system's: start-up stores
         a choice, carried over from use24Hour below so an upgrade keeps a deliberate
         12-hour one (main.qml). -->
    <entry name="clockFormat" type="Int">
      <default>-1</default>
    </entry>
    <!-- Deprecated: the "Use 24-hour time" checkbox clockFormat replaced. Read once at
         startup to carry a cleared box over, then cleared; to be removed, with that
         carry-over, a release or two on. -->
    <entry name="use24Hour" type="Bool">
      <default>true</default>
    </entry>
    <!-- Days the forecast shows, today included, in every layout (General →
         Forecast days): 1 to 10, the graph at least 3. -->
    <entry name="forecastDays" type="Int">
      <default>5</default>
    </entry>
    <!-- Deprecated: the per-layout day counts forecastDays replaced, the card
         layout's, the graph's and (further down) the Detailed view's. Read once at
         startup to carry a count that was set over, then cleared (main.qml); to be
         removed, with that carry-over, a release or two on. -->
    <entry name="dailyDays" type="Int">
      <default>5</default>
    </entry>
    <entry name="simpleDailyDays" type="Int">
      <default>5</default>
    </entry>
    <!-- Graph zoom: 0 = 12 hours, 1 = 24 hours, 2 = 48 hours. -->
    <entry name="graphZoom" type="Int">
      <default>1</default>
    </entry>
    <!-- Deprecated: the two-level zoom graphZoom replaced (true = the 12-hour view).
         Read once at startup to carry the choice over, then cleared. -->
    <entry name="simpleHourly" type="Bool">
      <default>false</default>
    </entry>
    <!-- up to 4 metrics shown in the DETAILED layout header next to the temperature -->
    <entry name="headerMetric1" type="String"><default>date</default></entry>
    <entry name="headerMetric2" type="String"><default>sun</default></entry>
    <entry name="headerMetric3" type="String"><default>precipSum</default></entry>
    <entry name="headerMetric4" type="String"><default>none</default></entry>
    <!-- independent header metrics for the SIMPLE layout -->
    <entry name="simpleHeaderMetric1" type="String"><default>date</default></entry>
    <entry name="simpleHeaderMetric2" type="String"><default>uv</default></entry>
    <entry name="simpleHeaderMetric3" type="String"><default>precipSum</default></entry>
    <entry name="simpleHeaderMetric4" type="String"><default>none</default></entry>
    <entry name="hourlyMetric1" type="String"><default>wind</default></entry>
    <entry name="hourlyMetric2" type="String"><default>precipAmt</default></entry>
    <!-- per-slot fallbacks, tried in order when the primary readout has no value
         for an hour (e.g. snow on a dry hour falls back to precip chance, then
         to wind) -->
    <entry name="hourlyMetric1Fallback" type="String"><default>none</default></entry>
    <entry name="hourlyMetric1Fallback2" type="String"><default>none</default></entry>
    <entry name="hourlyMetric2Fallback" type="String"><default>precip</default></entry>
    <entry name="hourlyMetric2Fallback2" type="String"><default>uv</default></entry>
    <!-- hour a non-today day opens at in the Detailed hourly timeline:
         6 = 6 AM (skip the overnight cards), 0 = midnight. Today always opens
         at the current hour regardless. -->
    <entry name="detailDayStartHour" type="Int"><default>6</default></entry>
    <entry name="refreshInterval" type="Int">
      <default>15</default>
    </entry>
    <!-- show official severe-weather alerts (worldwide, via the KDE FOSS Public
         Alert Server at alerts.kde.org); off by default so the widget makes no
         alert request unless the user opts in -->
    <entry name="showAlerts" type="Bool">
      <default>true</default>
    </entry>
    <!-- minimum alert severity to display (CAP rank): 1 Minor, 2 Moderate,
         3 Severe, 4 Extreme. Default 1 = Minor+ (Minor/Unknown filtered) -->
    <entry name="minAlertSeverity" type="Int">
      <default>1</default>
    </entry>
    <!-- send each new alert the widget shows to Plasma's notifications, once -->
    <entry name="alertNotifications" type="Bool">
      <default>true</default>
    </entry>
    <entry name="keepOpen" type="Bool">
      <default>false</default>
    </entry>
    <!-- How see-through the widget's background is, in percent: the popup's on a
         panel, and on the desktop the frame "Show Background" adds. 0 leaves the
         theme's background as it is. -->
    <entry name="backgroundTransparency" type="Int">
      <default>0</default>
    </entry>
    <entry name="heroIconSize" type="Int">
      <default>64</default>
    </entry>
    <entry name="tempFontSize" type="Int">
      <default>48</default>
    </entry>
    <entry name="dailyIconSize" type="Int">
      <default>46</default>
    </entry>
    <!-- card layout: the strip of hourly cards above the day tabs instead of below -->
    <entry name="hourlyCardsFirst" type="Bool">
      <default>false</default>
    </entry>
    <!-- card-layout day tabs: show the date (day and month) under each day name -->
    <entry name="showDayDate" type="Bool">
      <default>true</default>
    </entry>
    <!-- card-layout day tabs: pixel size of the day name; the date under it follows
         at 5/6 of it (16 → 13, the theme's 12 pt / 10 pt pair these replaced) -->
    <entry name="dailyNameFontSize" type="Int">
      <default>16</default>
    </entry>
    <!-- card-layout day tabs: pixel size of the "low | high" temperatures -->
    <entry name="dailyTempFontSize" type="Int">
      <default>16</default>
    </entry>
    <!-- pixel size of the wind-direction arrow (hourly cards + both Wind elements) -->
    <entry name="windArrowSize" type="Int">
      <default>21</default>
    </entry>
    <entry name="hourlyIconSize" type="Int">
      <default>46</default>
    </entry>
    <!-- Detailed hourly-card element font (time + per-hour readouts/glyphs) -->
    <entry name="hourlyCardFontSize" type="Int">
      <default>13</default>
    </entry>
    <entry name="hourlyTempFontSize" type="Int">
      <default>18</default>
    </entry>
    <!-- Header fonts, shared by BOTH layouts (Appearance → Common): the condition text
         under the temperature, the location button, and the weather-source button (its
         logo scales with it). Both layouts place these identically, so one size each. -->
    <entry name="conditionFontSize" type="Int">
      <default>20</default>
    </entry>
    <entry name="locationFontSize" type="Int">
      <default>17</default>
    </entry>
    <!-- the location's font weight: 400 / 600 / 700 -->
    <entry name="locationFontWeight" type="Int">
      <default>600</default>
    </entry>
    <entry name="providerFontSize" type="Int">
      <default>15</default>
    </entry>
    <!-- Weather Elements style: 0 = text labels ("Humidity: 78%"), 1 = icons (the
         hourly cards' icon before each value) -->
    <entry name="headerElementsStyle" type="Int">
      <default>1</default>
    </entry>
    <!-- the header's Weather Elements' icons in Meteocons' flat colours, rather than
         monochrome in the text colour. The other views have their own (below), the
         panel panelColorIcon and the graph's markers dayMarkerIconColored. -->
    <entry name="readingIconsColored" type="Bool">
      <default>false</default>
    </entry>
    <!-- weather-specific text colours for the header's Weather Elements' values (blue
         precipitation, the UV scale's green to red, …). Off, they are in the theme's
         text colour. -->
    <entry name="weatherSpecificColors" type="Bool">
      <default>true</default>
    </entry>
    <!-- The same two for the other views (Appearance → Daily forecast, Detailed view):
         the daily tabs' high and low in their colours; the hourly cards' readout icons
         and values; the Detailed view's element icons and values. -->
    <entry name="dailyHiLoColored" type="Bool">
      <default>true</default>
    </entry>
    <entry name="hourlyIconsColored" type="Bool">
      <default>false</default>
    </entry>
    <entry name="hourlyValuesColored" type="Bool">
      <default>false</default>
    </entry>
    <!-- the hourly cards' precipitation wash: rain blue from the bottom-left corner,
         snow white from the top-right (Appearance → Daily forecast → Hourly cards) -->
    <entry name="hourlyPrecipGradient" type="Bool">
      <default>true</default>
    </entry>
    <entry name="detailedIconsColored" type="Bool">
      <default>true</default>
    </entry>
    <entry name="detailedValuesColored" type="Bool">
      <default>true</default>
    </entry>
    <!-- the graph's markers in colour: the new-day icons in the icon pack's colours
         (else Meteocons' monochrome ones) and sunrise / sunset in Meteocons' flat
         colours with gold times (else monochrome), all in the text colour when off -->
    <entry name="dayMarkerIconColored" type="Bool">
      <default>true</default>
    </entry>
    <!-- Size of the popup's corner buttons (pin, zoom, layout switch, refresh) in
         pixels; their glyphs are drawn on a 24 px grid. -->
    <entry name="toolbarIconSize" type="Int">
      <default>24</default>
    </entry>
    <!-- the popup's layout, picked with the buttons under the day buttons: "details"
         the Detailed view, "cards" the card layout, "graph" the graph layout. Empty =
         never picked, as the card layout: start-up stores a layout, carried over from
         simpleLayout below so an upgrade keeps the layout it had (main.qml). -->
    <entry name="popupLayout" type="String">
      <default></default>
    </entry>
    <!-- Deprecated: the switch between the two first layouts popupLayout replaced,
         false = the card layout, true = the graph layout. Read once at startup to
         carry it over, then cleared; to be removed, with that carry-over, a release
         or two on. -->
    <entry name="simpleLayout" type="Bool">
      <default>false</default>
    </entry>
    <!-- The Detailed view (Appearance → Detailed view): its deprecated day count (see
         dailyDays), its elements in order — a JSON list of {"id", "shown"}, see
         contents/ui/detailedelements.js; empty = all of them in the default order —
         and their font: size in pixels, weight 400 / 600 / 700. -->
    <entry name="detailedViewDays" type="Int">
      <default>5</default>
    </entry>
    <entry name="detailedViewElements" type="String">
      <default></default>
    </entry>
    <entry name="detailedViewFontSize" type="Int">
      <default>16</default>
    </entry>
    <entry name="detailedViewFontWeight" type="Int">
      <default>600</default>
    </entry>
    <!-- How the Detailed view's elements come in when it opens, as a PERCENTAGE of the
         original pace (as cardDealDurationPercent): lower is faster, 0 = no animation.
         See entrance in DetailedView.qml. -->
    <entry name="detailedEntrancePercent" type="Int">
      <default>60</default>
    </entry>
    <!-- the layout buttons' text size in pixels (Appearance → Common) -->
    <entry name="layoutButtonFontSize" type="Int">
      <default>15</default>
    </entry>
    <!-- Per-layout remembered popup size (0 = use the view's implicit size).
         main.qml drives the popup window directly (Window.window) to restore the
         active layout's size on open / layout switch and capture user drags here;
         see the per-layout popup-size note in DEVELOPMENT.md for why. -->
    <!-- Entrance "deal" animation for the hourly cards, as a PERCENTAGE of the
         original duration — lower is faster, and it scales the per-card animation
         and the stagger between cards together. 100 = the original pace,
         60 = the default, 50 = twice as fast, 0 = no animation.
         See dealDuration in FullView.qml. -->
    <entry name="cardDealDurationPercent" type="Int">
      <default>60</default>
    </entry>
    <!-- How many hour cards one mouse-wheel notch moves the card strip. -->
    <entry name="cardsPerScroll" type="Int">
      <default>3</default>
    </entry>
    <!-- How long one mouse-wheel notch takes to slide the card strip, in
         milliseconds — the card layout's twin of graphSlideMs* below. Only notches:
         day-tab clicks, touchpad scrolling and the snap after a drag keep their own
         quick glide. 0 = jump straight there. -->
    <entry name="cardSlideMs" type="Int">
      <default>600</default>
    </entry>
    <!-- How many hours one mouse-wheel notch moves the graph, per zoom level.
         Defaults are a quarter of each zoom's visible window. -->
    <entry name="graphScrollHoursDay" type="Int">
      <default>4</default>
    </entry>
    <entry name="graphScrollHoursDetail" type="Int">
      <default>2</default>
    </entry>
    <entry name="graphScrollHoursWide" type="Int">
      <default>8</default>
    </entry>
    <!-- How long one mouse-wheel notch takes to slide the graph, per zoom level,
         in milliseconds. Separate from the step above because the two together
         set the speed: the same 350 ms reads as gentle over a 2-hour step and
         as a lurch over a 24-hour one. 0 = jump straight there. -->
    <entry name="graphSlideMsDetail" type="Int">
      <default>350</default>
    </entry>
    <entry name="graphSlideMsDay" type="Int">
      <default>600</default>
    </entry>
    <entry name="graphSlideMsWide" type="Int">
      <default>1000</default>
    </entry>
    <entry name="detailPopupWidth" type="Int">
      <default>868</default>
    </entry>
    <entry name="detailPopupHeight" type="Int">
      <default>480</default>
    </entry>
    <entry name="simplePopupWidth" type="Int">
      <default>868</default>
    </entry>
    <!-- the Detailed view's; its height follows the content until a drag sets one -->
    <entry name="detailedViewPopupWidth" type="Int">
      <default>868</default>
    </entry>
    <entry name="detailedViewPopupHeight" type="Int">
      <default>0</default>
    </entry>
    <entry name="simplePopupHeight" type="Int">
      <default>480</default>
    </entry>
    <!-- Latches true when the user manually resizes the Simple popup's WIDTH, so
         auto-fit-to-day-tabs stops overriding their size. Cleared when the day
         count changes (an explicit re-fit gesture). -->
    <entry name="simplePopupManual" type="Bool">
      <default>true</default>
    </entry>
    <entry name="simpleHourlyIconSize" type="Int">
      <default>34</default>
    </entry>
    <!-- Weather Elements (the metric lines beside the temperature): font size and
         weight, shared by both layouts. Weight is 400 Regular, 600 SemiBold or 700
         Bold; a font without a SemiBold draws the nearest face, normally its Bold. -->
    <entry name="headerInfoFontSize" type="Int">
      <default>14</default>
    </entry>
    <entry name="headerInfoFontWeight" type="Int">
      <default>600</default>
    </entry>
    <!-- Simple-layout graph hour-axis label font (the "6 PM 7 PM …" row) -->
    <entry name="simpleHourFontSize" type="Int">
      <default>13</default>
    </entry>
    <!-- Simple-layout graph per-point temperature label font (the "41° 40° …") -->
    <entry name="simpleGraphTempFontSize" type="Int">
      <default>16</default>
    </entry>
    <!-- the day buttons (the "Thu Fri Sat" pills) of the Detailed view and the Weather
         graph: pixel size (Appearance → Common) -->
    <entry name="dayPillFontSize" type="Int">
      <default>15</default>
    </entry>
    <!-- Simple-layout graph new-day marker label font (the "Fri, 18/09" at midnight) -->
    <entry name="simpleDayMarkerFontSize" type="Int">
      <default>14</default>
    </entry>
    <!-- Simple-layout graph colouring: 0 = temp+precip, 1 = temp only,
         2 = precip only, 3 = none (flat neutral), 4 = precip plus the temperature
         LINE, leaving the temperature wash neutral -->
    <entry name="graphColorMode" type="Int">
      <default>4</default>
    </entry>
    <!-- How dense the shaded band under the precipitation curve is, as the opacity
         of its top edge in percent; it fades from there toward the floor either way.
         0 leaves the curve as a bare line. -->
    <entry name="precipBandOpacity" type="Int">
      <default>25</default>
    </entry>
    <!-- Which halves of a precipitation readout the graph prints, as a bit pair:
         1 = the chance, 2 = the amount, so 3 = both and 0 = neither. -->
    <entry name="precipLabelMode" type="Int">
      <default>2</default>
    </entry>
    <!-- Whether a new-day marker on the graph reads "<weekday>, <date>" or the
         weekday alone. -->
    <entry name="showDayMarkerDate" type="Bool">
      <default>true</default>
    </entry>
    <!-- Which icons animate, in every layout (Appearance → Common → Weather icon
         animation): 0 none, 1 the header icon, 2 the header and the Daily forecast's
         day tabs, 3 the full layout. -->
    <entry name="cardAnimation" type="Int">
      <default>1</default>
    </entry>
    <entry name="panelIconPercent" type="Int">
      <default>130</default>
    </entry>
    <entry name="panelFontPercent" type="Int">
      <default>72</default>
    </entry>
    <!-- use the colored icon variant in the panel instead of the one-colour icon drawn
         in the panel's text colour -->
    <entry name="panelColorIcon" type="Bool">
      <default>false</default>
    </entry>
    <!-- What the panel shows, in order (Appearance → Panel → Panel Elements): a JSON list
         of {"id", "shown"}. The ids: "icon", "temp", "location", "condition", and the
         readings "hiLo", "precipRate", "wind", "feelsLike", "humidity", "precipSum",
         "uv", "pressure", "sun", "dewPoint", "snowSum", "cloud" (see
         contents/ui/panelelements.js). Empty = never edited: the weather icon and the
         temperature. An upgrade gets what the older panelDisplay below showed,
         carried over once at startup (main.qml). -->
    <entry name="panelElements" type="String">
      <default></default>
    </entry>
    <!-- Deprecated: the "Panel display" panelElements replaced, with the two below.
         Read once at startup to carry it over, then cleared; to be removed, with that
         carry-over, a release or two on. 0 the weather icon and temperature, 1 the
         icon alone, 2 the temperature alone, 3 the detailed view (icon, temperature
         and the panelSecondLine reading), 4 the icon, temperature and condition;
         -1 = never chosen, panelDetailed decides -->
    <entry name="panelDisplay" type="Int">
      <default>-1</default>
    </entry>
    <!-- Deprecated: the older "Detailed View" checkbox (see panelDisplay) -->
    <entry name="panelDetailed" type="Bool">
      <default>false</default>
    </entry>
    <!-- Deprecated: the older detailed view's reading (see panelDisplay): 0 high /
         low temperature, 1 this hour's precipitation, 2 wind, 3 feels like, 4 humidity,
         5 precipitation sum, 6 UV index, 7 air pressure, 8 sunrise / sunset, 9 dew
         point, 10 snowfall, 11 cloud cover -->
    <entry name="panelSecondLine" type="Int">
      <default>0</default>
    </entry>
    <!-- panel temperature font weight: 400 regular, 600 semibold, 700 bold -->
    <entry name="panelTempFontWeight" type="Int">
      <default>400</default>
    </entry>
    <!-- The panel's secondary font — everything on it but the weather icon and the
         temperature: the location, the condition and the readings. Its weight (the same
         values), and its size as a % of the panel's thickness. -->
    <entry name="panelSecondLineFontWeight" type="Int">
      <default>600</default>
    </entry>
    <entry name="panelSecondLinePercent" type="Int">
      <default>52</default>
    </entry>
    <!-- pixels added to the space the panel leaves between its elements (none beside
         the weather icon, else a quarter of the panel's thickness), on both sides of a
         separator, and between a vertical panel's lines; negative brings them closer -->
    <entry name="panelElementSpacing" type="Int">
      <default>0</default>
    </entry>
    <!-- drawn between the panel's elements, in the secondary font, but never between
         the weather icon and the temperature: 0 none, 1 a bullet "•", 2 custom, the
         character in panelElementSeparatorText -->
    <entry name="panelElementSeparator" type="Int">
      <default>0</default>
    </entry>
    <entry name="panelElementSeparatorText" type="String">
      <default></default>
    </entry>
    <!-- condition-icon pack: a bundled Meteocons style ("meteocons-fill", "-flat", "-line",
         "-monochrome"), "system" (theme weather-* icons), or "custom" -->
    <entry name="iconPack" type="String">
      <default>meteocons-fill</default>
    </entry>
    <!-- The icons before the readings in colour, wherever a view's "Use colored icons"
         is on (Appearance → Common → Element icon pack): "meteocons-flat",
         "meteocons-line" or "custom", the folder readingIconDir (a file:// URL). -->
    <entry name="readingIconPack" type="String">
      <default>meteocons-line</default>
    </entry>
    <entry name="readingIconDir" type="String">
      <default></default>
    </entry>
    <!-- folder of the user's own icons when iconPack = "custom" (a file:// URL) -->
    <entry name="customIconDir" type="String">
      <default></default>
    </entry>
  </group>
</kcfg>
