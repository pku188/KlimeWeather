<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0
                          http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
  <kcfgfile name=""/>
  <group name="General">
    <!-- No default location: a fresh install starts unconfigured (see
         locationConfigured below) and shows a "set your location" prompt instead
         of a stand-in city. Coordinates stay 0 and are never fetched until the
         user sets a location, which flips locationConfigured true. -->
    <!-- Which weather API supplies the forecast. GLOBAL, not per-location:
         saved locations are plain coordinates, so every one of them works with
         every provider and switching providers never asks for a location twice.
         Must match a key in main.qml's `providers` registry; an unknown value
         falls back to openmeteo. -->
    <entry name="weatherProvider" type="String">
      <default>metno</default>
    </entry>
    <entry name="latitude" type="Double">
      <default>0</default>
    </entry>
    <entry name="longitude" type="Double">
      <default>0</default>
    </entry>
    <entry name="locationName" type="String">
      <default></default>
    </entry>
    <!-- JSON array of { name, lat, lon } entries -->
    <entry name="savedLocations" type="String">
      <default>[]</default>
    </entry>
    <!-- latches true the first time the user sets their own location (any
         method); false out of the box drives the first-run "set your location"
         hint in the popup, which hides once a real location is chosen -->
    <!-- IANA zone of the active location ("Europe/Oslo"), captured from the
         geocoder. Resolved to a live UTC offset through Plasma's time dataengine
         so a provider that reports no timezone (met.no) can still be rendered in
         the location's own clock. Empty = fall back to the viewer's zone, which
         is what a hand-entered coordinate or a pre-existing saved location gets. -->
    <entry name="locationTimezone" type="String">
      <default></default>
    </entry>
    <entry name="locationConfigured" type="Bool">
      <default>false</default>
    </entry>
    <!-- temperature unit: celsius, fahrenheit, or system (the system locale's
         measurement system, LC_MEASUREMENT: °F where it is US imperial) -->
    <entry name="temperatureUnit" type="String">
      <default>system</default>
    </entry>
    <!-- whether the temperature unit has been decided — by the user, or auto-picked
         from the first location's country during setup. Gates the auto-pick so it
         never overrides a deliberate choice. -->
    <entry name="unitConfigured" type="Bool">
      <default>true</default>
    </entry>
    <!-- wind speed unit: auto (follows the system locale's measurement system), kmh,
         mph, ms or kn -->
    <entry name="windUnit" type="String">
      <default>auto</default>
    </entry>
    <!-- air pressure unit: auto (follows the system locale's measurement system), hPa,
         inHg or mmHg -->
    <entry name="pressureUnit" type="String">
      <default>auto</default>
    </entry>
    <!-- Clock format: 0 follows the system default (the locale's own time format),
         1 = 12-hour, 2 = 24-hour. -1 = never chosen: derived from use24Hour below,
         the older checkbox, so an upgrade keeps a deliberate 12-hour choice. -->
    <entry name="clockFormat" type="Int">
      <default>-1</default>
    </entry>
    <!-- older "Use 24-hour time" checkbox, now only read to derive clockFormat -->
    <entry name="use24Hour" type="Bool">
      <default>true</default>
    </entry>
    <entry name="dailyDays" type="Int">
      <default>5</default>
    </entry>
    <!-- Days the graph layout spans, today included (independent of dailyDays).
         3 to 5: three is what both providers can draw as a real hourly curve; past
         that, MET Norway's days are built from stretched 6-hour blocks. -->
    <entry name="simpleDailyDays" type="Int">
      <default>4</default>
    </entry>
    <!-- Graph zoom: 0 = 12 hours, 1 = 24 hours, 2 = 48 hours. -->
    <entry name="graphZoom" type="Int">
      <default>1</default>
    </entry>
    <!-- Deprecated: the two-level zoom graphZoom replaced (true = the 12-hour view).
         Read once at startup to carry the choice over, then cleared. -->
    <entry name="simpleHourly" type="Bool">
      <default>false</default>
    </entry>
    <!-- up to 4 metrics shown in the DETAILED layout header next to the temperature -->
    <entry name="headerMetric1" type="String"><default>sun</default></entry>
    <entry name="headerMetric2" type="String"><default>precipSum</default></entry>
    <entry name="headerMetric3" type="String"><default>pressure</default></entry>
    <entry name="headerMetric4" type="String"><default>none</default></entry>
    <!-- independent header metrics for the SIMPLE layout -->
    <entry name="simpleHeaderMetric1" type="String"><default>uv</default></entry>
    <entry name="simpleHeaderMetric2" type="String"><default>precipSum</default></entry>
    <entry name="simpleHeaderMetric3" type="String"><default>pressure</default></entry>
    <entry name="simpleHeaderMetric4" type="String"><default>wind</default></entry>
    <entry name="hourlyMetric1" type="String"><default>wind</default></entry>
    <entry name="hourlyMetric2" type="String"><default>precip</default></entry>
    <!-- per-slot fallbacks, tried in order when the primary readout has no value
         for an hour (e.g. snow on a dry hour falls back to precip chance, then
         to wind) -->
    <entry name="hourlyMetric1Fallback" type="String"><default>none</default></entry>
    <entry name="hourlyMetric1Fallback2" type="String"><default>none</default></entry>
    <entry name="hourlyMetric2Fallback" type="String"><default>precipAmt</default></entry>
    <entry name="hourlyMetric2Fallback2" type="String"><default>uv</default></entry>
    <!-- hour a non-today day opens at in the Detailed hourly timeline:
         6 = 6 AM (skip the overnight cards), 0 = midnight. Today always opens
         at the current hour regardless. -->
    <entry name="detailDayStartHour" type="Int"><default>6</default></entry>
    <entry name="refreshInterval" type="Int">
      <default>15</default>
    </entry>
    <!-- show official severe-weather alerts (worldwide, via the KDE FOSS Public
         Alert Server at alerts.kde.org); off by default so the widget makes no
         alert request unless the user opts in -->
    <entry name="showAlerts" type="Bool">
      <default>true</default>
    </entry>
    <!-- minimum alert severity to display (CAP rank): 1 Minor, 2 Moderate,
         3 Severe, 4 Extreme. Default 2 = Moderate+ (Minor/Unknown filtered) -->
    <entry name="minAlertSeverity" type="Int">
      <default>2</default>
    </entry>
    <entry name="keepOpen" type="Bool">
      <default>false</default>
    </entry>
    <entry name="heroIconSize" type="Int">
      <default>64</default>
    </entry>
    <entry name="tempFontSize" type="Int">
      <default>48</default>
    </entry>
    <entry name="dailyIconSize" type="Int">
      <default>46</default>
    </entry>
    <!-- card-layout day tabs: show the date (day and month) under each day name -->
    <entry name="showDayDate" type="Bool">
      <default>true</default>
    </entry>
    <!-- card-layout day tabs: pixel size of the "low | high" temperatures -->
    <entry name="dailyTempFontSize" type="Int">
      <default>16</default>
    </entry>
    <!-- pixel size of the wind-direction arrow (hourly cards + both Wind elements) -->
    <entry name="windArrowSize" type="Int">
      <default>21</default>
    </entry>
    <entry name="hourlyIconSize" type="Int">
      <default>46</default>
    </entry>
    <entry name="hourlyInfoFontSize" type="Int">
      <default>11</default>
    </entry>
    <!-- Detailed hourly-card element font (time + per-hour readouts/glyphs) -->
    <entry name="hourlyCardFontSize" type="Int">
      <default>13</default>
    </entry>
    <entry name="hourlyTempFontSize" type="Int">
      <default>18</default>
    </entry>
    <!-- Header fonts, shared by BOTH layouts (Appearance → Common): the condition text
         under the temperature, the location button, and the weather-source button (its
         logo scales with it). Both layouts place these identically, so one size each. -->
    <entry name="conditionFontSize" type="Int">
      <default>20</default>
    </entry>
    <entry name="locationFontSize" type="Int">
      <default>18</default>
    </entry>
    <entry name="providerFontSize" type="Int">
      <default>15</default>
    </entry>
    <!-- which popup layout to open with: false = Detailed (cards), true = Simple
         (graph). Defaults to the card layout. -->
    <entry name="simpleLayout" type="Bool">
      <default>false</default>
    </entry>
    <!-- Per-layout remembered popup size (0 = use the view's implicit size).
         main.qml drives the popup window directly (Window.window) to restore the
         active layout's size on open / layout switch and capture user drags here;
         see the per-layout popup-size note in DEVELOPMENT.md for why. -->
    <!-- Entrance "deal" animation for the hourly cards, as a PERCENTAGE of the
         original duration — lower is faster, and it scales the per-card animation
         and the stagger between cards together. 100 = the original pace,
         60 = the default, 50 = twice as fast, 0 = no animation.
         See dealDuration in FullView.qml. -->
    <entry name="cardDealDurationPercent" type="Int">
      <default>60</default>
    </entry>
    <!-- How many hour cards one mouse-wheel notch moves the card strip. -->
    <entry name="cardsPerScroll" type="Int">
      <default>3</default>
    </entry>
    <!-- How many hours one mouse-wheel notch moves the graph, per zoom level.
         Defaults are a quarter of each zoom's visible window. -->
    <entry name="graphScrollHoursDay" type="Int">
      <default>4</default>
    </entry>
    <entry name="graphScrollHoursDetail" type="Int">
      <default>2</default>
    </entry>
    <entry name="graphScrollHoursWide" type="Int">
      <default>8</default>
    </entry>
    <!-- How long one mouse-wheel notch takes to slide the graph, per zoom level,
         in milliseconds. Separate from the step above because the two together
         set the speed: the same 350 ms reads as gentle over a 2-hour step and
         as a lurch over a 24-hour one. 0 = jump straight there. -->
    <entry name="graphSlideMsDetail" type="Int">
      <default>350</default>
    </entry>
    <entry name="graphSlideMsDay" type="Int">
      <default>600</default>
    </entry>
    <entry name="graphSlideMsWide" type="Int">
      <default>1000</default>
    </entry>
    <entry name="detailPopupWidth" type="Int">
      <default>920</default>
    </entry>
    <entry name="detailPopupHeight" type="Int">
      <default>480</default>
    </entry>
    <entry name="simplePopupWidth" type="Int">
      <default>920</default>
    </entry>
    <entry name="simplePopupHeight" type="Int">
      <default>480</default>
    </entry>
    <!-- Latches true when the user manually resizes the Simple popup's WIDTH, so
         auto-fit-to-day-tabs stops overriding their size. Cleared when the day
         count changes (an explicit re-fit gesture). -->
    <entry name="simplePopupManual" type="Bool">
      <default>true</default>
    </entry>
    <entry name="simpleHourlyIconSize" type="Int">
      <default>34</default>
    </entry>
    <!-- Which icons animate in the graph layout: 0 none, 1 the header icon, 2 the
         full layout. -1 = never chosen: derived from simpleAnimatedIcons and
         simpleHeaderAnim below, the older per-part switches, so an upgrade keeps
         what was set. -->
    <entry name="graphAnimation" type="Int">
      <default>1</default>
    </entry>
    <!-- older graph switches, now only read to derive graphAnimation -->
    <entry name="simpleAnimatedIcons" type="Bool">
      <default>true</default>
    </entry>
    <entry name="simpleHeaderAnim" type="Bool">
      <default>true</default>
    </entry>
    <!-- Internal, set once at startup: the location fonts used to follow the condition
         fonts, so on the first run after the split they are copied from them, keeping
         the size a user had set. After that the two are independent. -->
    <entry name="locationFontsSplit" type="Bool">
      <default>true</default>
    </entry>
    <!-- Weather Elements (the metric lines beside the temperature): font size and
         weight, shared by both layouts. Weight is 400 Regular, 600 SemiBold or 700
         Bold; a font without a SemiBold draws the nearest face, normally its Bold. -->
    <entry name="headerInfoFontSize" type="Int">
      <default>14</default>
    </entry>
    <entry name="headerInfoFontWeight" type="Int">
      <default>600</default>
    </entry>
    <!-- Simple-layout graph hour-axis label font (the "6 PM 7 PM …" row) -->
    <entry name="simpleHourFontSize" type="Int">
      <default>13</default>
    </entry>
    <!-- Simple-layout graph per-point temperature label font (the "41° 40° …") -->
    <entry name="simpleGraphTempFontSize" type="Int">
      <default>16</default>
    </entry>
    <!-- Simple-layout graph new-day marker label font (the "Fri, 18/09" at midnight) -->
    <entry name="simpleDayMarkerFontSize" type="Int">
      <default>14</default>
    </entry>
    <!-- Simple-layout graph colouring: 0 = temp+precip, 1 = temp only,
         2 = precip only, 3 = none (flat neutral), 4 = precip plus the temperature
         LINE, leaving the temperature wash neutral -->
    <entry name="graphColorMode" type="Int">
      <default>4</default>
    </entry>
    <!-- How dense the shaded band under the precipitation curve is, as the opacity
         of its top edge in percent; it fades from there toward the floor either way.
         0 leaves the curve as a bare line. -->
    <entry name="precipBandOpacity" type="Int">
      <default>25</default>
    </entry>
    <!-- Which halves of a precipitation readout the graph prints, as a bit pair:
         1 = the chance, 2 = the amount, so 3 = both and 0 = neither. -->
    <entry name="precipLabelMode" type="Int">
      <default>2</default>
    </entry>
    <!-- Whether a new-day marker on the graph reads "<weekday>, <date>" or the
         weekday alone. -->
    <entry name="showDayMarkerDate" type="Bool">
      <default>true</default>
    </entry>
    <!-- Which icons animate in the card layout: 0 none, 1 the header icon, 2 the
         header and daily tab icons, 3 the full layout. -1 = never chosen: derived
         from animatedDailyIcons and animatedHourlyIcons below, the older per-part
         switches, so an upgrade keeps what was set. -->
    <entry name="cardAnimation" type="Int">
      <default>1</default>
    </entry>
    <!-- older card switches, now only read to derive cardAnimation -->
    <entry name="animatedDailyIcons" type="Bool">
      <default>true</default>
    </entry>
    <entry name="animatedHourlyIcons" type="Bool">
      <default>true</default>
    </entry>
    <entry name="panelIconPercent" type="Int">
      <default>130</default>
    </entry>
    <entry name="panelFontPercent" type="Int">
      <default>72</default>
    </entry>
    <!-- use the colored icon variant in the panel instead of the white one -->
    <entry name="panelColorIcon" type="Bool">
      <default>true</default>
    </entry>
    <!-- show condition text + H/L below the temperature instead of just the temperature -->
    <entry name="panelDetailed" type="Bool">
      <default>false</default>
    </entry>
    <!-- detailed panel second line: 0 = H/L temperature, 1 = precip chance / amount, 2 = wind speed / gust -->
    <entry name="panelSecondLine" type="Int">
      <default>0</default>
    </entry>
    <!-- detailed-panel font sizes, as a % of panel height (condition word / second line) -->
    <entry name="panelConditionPercent" type="Int">
      <default>40</default>
    </entry>
    <entry name="panelSecondLinePercent" type="Int">
      <default>37</default>
    </entry>
    <!-- condition-icon pack: a bundled Meteocons style ("meteocons-fill", "-flat", "-line",
         "-monochrome"), "system" (theme weather-* icons), or "custom" -->
    <entry name="iconPack" type="String">
      <default>meteocons-fill</default>
    </entry>
    <!-- folder of the user's own icons when iconPack = "custom" (a file:// URL) -->
    <entry name="customIconDir" type="String">
      <default></default>
    </entry>
  </group>
</kcfg>
